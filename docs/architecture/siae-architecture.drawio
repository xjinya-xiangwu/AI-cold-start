<mxfile host="app.diagrams.net" modified="2026-10-02T13:00:00.000Z" agent="kurtx/ZCode" version="24.7.5">
  <diagram id="siae-layered-arch" name="SIAE 分层架构">
    <mxGraphModel dx="1000" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SIAE 自进化智能体环境包 · 分层架构总图（信息采集 → 自进化） v2026-10-02" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="16" width="760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="base" value="&lt;b&gt;支撑底座（贯穿全层）：SIAE 总控协议层&lt;/b&gt;&lt;br&gt;AGENTS.md 会话首尾协议 · STATUS 全貌快照 · broadcast/log 广播 · 子仓库 gitlinks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="760" height="56" as="geometry" />
        </mxCell>
        <mxCell id="L0" value="&lt;b&gt;L0 感知层 · 信息采集&lt;/b&gt;（每日 08:30 自动）&lt;br&gt;外部世界：aihot 精选流（主通道）/ GitHub 三路 / 四家 harness 发版正文&lt;br&gt;→ daily-collect.py（24h 窗口 · sha256 全库去重 · 幂等）→ 本地素材库 SIAE-materials（jsonl，canonical）&lt;br&gt;→ Notion「SIAE 素材库」db（人读视图；Status：未筛/周报/试评/观察/拒）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="148" width="760" height="96" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;L1 过滤层 · 规则引擎 + 校准闭环&lt;/b&gt;（每周）&lt;br&gt;keywords.json 五支柱评分分桶（P1 模型 / P2 技能 / P3 harness / P4 方法 / PM）· 双人格（PM 用户版 ≠ 内部过滤）&lt;br&gt;校准：误桶样本 → gold → 规则修订 → 重放对账；--eval 度量 precision / recall / 误桶率（目标 ≥80% / &lt;10%）&lt;br&gt;产出：周报草稿 = Δ动作卡（A/B/C）+ S/M 榜 + gold 负样本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="272" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;L2 决策层 · 周会&lt;/b&gt;（每周）&lt;br&gt;读者分离：周报给 agent（A 自动排程 / B 沙箱对照 / C 等拍板）· 决策简报给老板（一页纸 C 类）· PM 用户版（商品形态）&lt;br&gt;用户三态：试评（仅进评测池）｜观察（默认，不执行）｜不考虑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="404" width="760" height="88" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;L3 执行层 · 环境变更&lt;/b&gt;&lt;br&gt;L3a 分发 asp：install / update / mcp 预设 / doctor / export → 10 agent（packs：base 25 + ai-pm 12；managed-section 只增不覆盖）&lt;br&gt;L3b 同步 agent-sync：age 凭证加密 / MCP 拉齐 / 跨端一致（契约：asp 管结构 · agent-sync 管值）&lt;br&gt;评测与回归门：试评 → 同题公开样本 + held-out → 过门才入 L1 / 商品" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="760" height="112" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;L4 反馈与沉淀层 · 知识库&lt;/b&gt;&lt;br&gt;回执闭环：执行结果 → 下期周报第 0 节（已排程 ≠ 完成，回执为准）&lt;br&gt;沉淀物：gold 负样本 / 校准存证 / held-out / 拒收理由 / 决议与回执&lt;br&gt;知识存储分层：L0 外部事实+拒收理由 / L1 过评测与发布门的包内容 / L2 真实使用+专家纠错 / L4 gold+版本回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="note" value="注：L0-L4 双语义——流程层（本图，信息在漏斗中的位置）vs 知识存储分层（入库门槛与信任等级），同名不同义，检索按上下文区分。&lt;br&gt;分层检索表与各层详情：Notion 主文档 §4.1 及各模块子页（SIAE 总控 / 产品中心 L3a / 情报漏斗 / 跨端同步 L3b）。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="788" width="760" height="48" as="geometry" />
        </mxCell>
        <mxCell id="eBase" value="协议约束（贯穿全层）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;fontSize=10;fontColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="base" target="L0">
