{
  "servers": {
    "asp-playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "asp-filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "~/Documents"],
      "env": {}
    },
    "asp-supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    }
  }
}
